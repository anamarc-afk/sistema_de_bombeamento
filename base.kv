#:kivy 1.11.1
MDBoxLayout:
    orientation: "vertical"
    md_bg_color: app.theme_cls.bg_normal

    MDTopAppBar:
        title: "Monitoramento de Tensões - Bancada"
        elevation: 4
        pos_hint: {"top": 1}
        md_bg_color: app.theme_cls.primary_color
        specific_text_color: 1, 1, 1, 1

    # Este container receberá o widget do Matplotlib via Python
    MDBoxLayout:
        id: graph_container
        orientation: "vertical"
        padding: "16dp"
        spacing: "8dp"

<JanelaTensoesContent>:
    orientation: "vertical"
    spacing: "12dp"
    size_hint_y: None
    height: "120dp"

    MDLabel:
        text: "Tensão RS: " + root.tensao_rs + " V"
        theme_text_color: "Primary"
        font_style: "H6"
    
    MDLabel:
        text: "Tensão ST: " + root.tensao_st + " V"
        theme_text_color: "Primary"
        font_style: "H6"

    MDLabel:
        text: "Tensão TR: " + root.tensao_tr + " V"
        theme_text_color: "Primary"
        font_style: "H6"